# Copy this file to ".env" and fill in the values.

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: your server ID. When set, slash commands sync instantly to that server
# (global sync can take up to an hour to show up).
GUILD_ID=

# Comma-separated Discord user IDs that are always bot admins (server owner is always admin).
ADMIN_USER_IDS=

# Comma-separated role IDs whose members are bot admins.
ADMIN_ROLE_IDS=

# Comma-separated channel IDs where games may be played.
# You can also manage these in Discord with /config channel-add.
GAMBLING_CHANNEL_IDS=

# Economy defaults
STARTING_BALANCE=20000
DAILY_AMOUNT=400
MIN_BET=10

# Restart: players who drop below MIN_BET press a button RESTART_PRESSES times to get RESTART_AMOUNT credits
RESTART_AMOUNT=500
RESTART_PRESSES=1
# Restarts are locked for this many seconds after sending credits with /pay (0 = never locked)
RESTART_PAY_BLOCK_SECONDS=3600
# 0 = unlimited
MAX_BET=0

# House edge used by dice, crash, mines, tower, higher-or-lower, coinflip and horse racing (0.02 = 2%)
HOUSE_EDGE=0.02

# Rake taken from every poker pot (0 = none, 0.05 = 5%)
POKER_RAKE=0

# Average share of bets the /slots machine pays back (0.99 = 99%). Separate from HOUSE_EDGE.
SLOTS_RTP=0.99
# 0 = hide Cosmic Lab's bonus buy (/slots buy:).
SLOTS_BUYS=1

# Average share of bets Banger Bash pays back (0.99 = 99%), in /bangerbash and in the Activity.
BANGER_RTP=0.99
# 0 = hide Banger Bash's bonus buys.
BANGER_BUYS=1
# /bangerbash opens the Activity. 1 = play it in the text channel instead (the chat version).
BANGERBASH_IN_CHAT=0

# Reef Rush (7x7 cluster slot in the Activity). Off until set to 1: it stays out of the game menu and /casino.
REEF_RUSH_ENABLED=0
# Average share of bets Reef Rush pays back (0.99 = 99%).
REEF_RTP=0.99
# 0 = hide Reef Rush's bonus buys.
REEF_BUYS=1

# Raccoon Heist (8x8 vault raid slot in the Activity). Off until set to 1: it stays out of the game menu and /casino.
RACCOON_HEIST_ENABLED=0
# Average share of bets Raccoon Heist pays back (0.99 = 99%), paid spins and bonus buys alike.
HEIST_RTP=0.99
# 0 = hide Raccoon Heist's bonus buys.
HEIST_BUYS=1

# Lottery
LOTTERY_TICKET_PRICE=100
LOTTERY_INTERVAL_HOURS=24
# Credits the bank adds to every draw's jackpot, on top of ticket sales. Paid only when the round sold tickets;
# it doesn't carry over to the next round. 0 = no bonus.
LOTTERY_BANK_BONUS=0

# Cockfight: win chance starts at BASE, +STEP per win, capped at MAX. Pays 2x minus HOUSE_EDGE.
COCKFIGHT_BASE_CHANCE=0.5
COCKFIGHT_CHANCE_STEP=0.01
COCKFIGHT_MAX_CHANCE=0.7

# Shop default prices. Mute and deafen share the VOICE prices. Admins can override per server with /config shop-price.
SHOP_CHICKEN_PRICE=1000
SHOP_DISCONNECT_PRICE=5000
SHOP_VOICE_1MIN_PRICE=1000
SHOP_VOICE_5MIN_PRICE=4000
SHOP_TIMEOUT_5MIN_PRICE=8000
SHOP_TIMEOUT_15MIN_PRICE=20000
SHOP_TIMEOUT_30MIN_PRICE=35000
SHOP_NICKNAME_PRICE=10000
SHOP_RANDOMKICK_PRICE=2500
# A random kick fires between 0 and this many seconds after it's bought
RANDOM_KICK_MAX_DELAY=300

# Spin Frenzy (Discord Activity in voice calls). See "Spin Frenzy setup" in the README.
# OAuth2 client secret from the Developer Portal (OAuth2 page). Players can't sign in without it.
DISCORD_CLIENT_SECRET=
# 0 turns the Activity's web server off
ACTIVITY_ENABLED=1
# Where the Activity's web server listens. In Docker, docker-compose.yml sets this for you.
ACTIVITY_HOST=127.0.0.1
ACTIVITY_PORT=8765
# The live blackjack dealer's voice (made on this machine, see the README). Kokoro: kokoro-v1.0.onnx with
# voices-v1.0.bin in the same folder, and DEALER_VOICE_NAME picks the speaker (af_heart, af_bella, bf_emma, ...).
# Or a Piper model like voices/en_US-lessac-medium.onnx (faster, more robotic). Empty = no server voice.
DEALER_VOICE_MODEL=voices/kokoro-v1.0.onnx
DEALER_VOICE_NAME=af_heart
# Share of bets paid back on the number spots 1, 2, 5 and 10 (0.97 = 97%)
SPIN_FRENZY_RTP=0.97
# Share of bets paid back on the four bonus spots (1.00 = break-even on average). Above 1 players who bet
# on bonuses get richer over time. The prize tables reshape themselves to hit this; the rare big prizes stay.
SPIN_FRENZY_BONUS_PAYBACK=1.00
# How much more often bonus rounds come up than their share of the wheel (1 = fair share, max 3).
# Higher = bonuses more often but smaller prizes on average (the payback above stays the same).
SPIN_FRENZY_BONUS_WEIGHT=1.5
SPIN_FRENZY_BET_SECONDS=15
# Most a single bet can win, as a multiple of the bet (0 = no limit)
SPIN_FRENZY_MAX_WIN=10000

# Admin panel: a website on this machine with stats, the money distribution and every player's balance, which you
# can edit there (without anything being posted in Discord). Off until ADMIN_PANEL_ENABLED=1, and it won't start
# without a password. It's for you only: never point a tunnel or reverse proxy at it. See "Admin panel" in the README.
ADMIN_PANEL_ENABLED=0
ADMIN_PANEL_PASSWORD=
# Where it listens: open http://127.0.0.1:8780 in your browser. In Docker, docker-compose.yml sets the host for you.
ADMIN_PANEL_HOST=127.0.0.1
ADMIN_PANEL_PORT=8780
# Docker only: 0.0.0.0 makes the panel reachable from other devices on your home network (LAN) as well, at
# http://<this machine's LAN address>:8780. Anyone on that network then gets the sign-in page, so use a strong
# password, and only do this on a network you trust (not public Wi-Fi). Takes effect after "docker compose up -d".
ADMIN_PANEL_BIND=127.0.0.1
# Sign in with Discord: besides the password, the sign-in page has a "Sign in with Discord" button (it needs
# DISCORD_CLIENT_SECRET above). The bot's owner in the Developer Portal (or every member of its team) gets in that
# way; ADMIN_PANEL_USERS lets more people in: Discord user IDs, separated by commas. Add every address you open the
# panel on under OAuth2 -> Redirects in the Developer Portal, ending in /api/auth/discord, for example
# http://127.0.0.1:8780/api/auth/discord
ADMIN_PANEL_USERS=

# Where the database is kept. In Docker, docker-compose.yml puts it (and the logs) in a volume instead.
DATABASE_PATH=gamble.db

# Logging. Console level: DEBUG, INFO or WARNING. The log file (logs/jaxcasino.log, rotated at 5 MB)
# always records full detail, including every button click.
LOG_LEVEL=INFO
LOG_DIR=logs

# Docker only: the container's time zone, for timestamps in the logs (default UTC).
# TZ=Europe/Amsterdam
