# Secrets: the bot token and client secret live here. Copy .env.example to .env instead.
.env
.env.*
!.env.example
config.json

# The databases: everyone's balances and Discord IDs
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# Logs and Python leftovers
logs/
*.log
*.log.*
__pycache__/
*.py[cod]
.venv/
venv/

# Voice models: too big for GitHub (download them with python download_voices.py)
voices/*
!voices/README.md

# Local tools and notes
.claude/
mockups/
research/
.vscode/
.idea/
Thumbs.db
.DS_Store

# Agent skills installed with "npx skills add" (local tooling)
.agents/
skills-lock.json

# The admin panel's page is built from admin_panel/web (npm run build, or the Docker image builds it), so neither
# the build output nor the installed packages go on GitHub.
admin_panel/static/
admin_panel/web/node_modules/
